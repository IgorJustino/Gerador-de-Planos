# ========================================
# APLICAÇÃO
# ========================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ========================================
# POSTGRESQL
# ========================================
DATABASE_URL=postgresql://planos:planos@localhost:5432/planos
DATABASE_POOL_MAX=5
DATABASE_SSL=false

# ========================================
# AUTENTICAÇÃO (MARCO 3B)
# ========================================
# Use um segredo longo e aleatório fora dos testes.
JWT_SECRET=dev-only-change-this-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=copiloto_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
GENERATION_RATE_LIMIT_MAX=5
GENERATION_RATE_LIMIT_WINDOW_MS=3600000

# ========================================
# INTEGRAÇÃO GEMINI
# ========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=1
AI_QUALITY_MIN_SCORE=80
AI_QUALITY_REVIEW_ENABLED=true
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_MS=15000

# ========================================
# INSTRUÇÕES
# ========================================
# 1. Copie este arquivo para .env.
# 2. Suba o PostgreSQL com: docker compose up -d postgres.
# 3. Execute migrations manualmente antes de usar /ready.
# 4. Nunca commite o arquivo .env.
