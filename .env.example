# ========================================
# APLICAÇÃO
# ========================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ========================================
# POSTGRESQL
# ========================================
DATABASE_URL=postgresql://planos:planos@localhost:5432/planos
DATABASE_POOL_MAX=5
DATABASE_SSL=false

# ========================================
# AUTENTICAÇÃO (MARCO 3B)
# ========================================
# Use um segredo longo e aleatório fora dos testes.
JWT_SECRET=dev-only-change-this-secret
JWT_EXPIRES_IN=8h
COOKIE_NAME=copiloto_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ========================================
# INTEGRAÇÕES LEGADAS (OPCIONAIS NO MARCO 2)
# ========================================
# Quando as três variáveis estiverem configuradas, as rotas antigas de planos
# continuarão disponíveis enquanto o MVP não as substituir.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# ========================================
# INSTRUÇÕES
# ========================================
# 1. Copie este arquivo para .env.
# 2. Suba o PostgreSQL com: docker compose up -d postgres.
# 3. Execute migrations manualmente antes de usar /ready.
# 4. Nunca commite o arquivo .env.
