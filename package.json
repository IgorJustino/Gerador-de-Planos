{
  "name": "gerador-planos-aula",
  "version": "1.0.0",
  "description": "Sistema gerador de planos de aula personalizados com IA",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node --check src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "migrate:up": "node-pg-migrate up --migrations-dir database/migrations --database-url-var DATABASE_URL",
    "migrate:down": "node-pg-migrate down --migrations-dir database/migrations --database-url-var DATABASE_URL",
    "migrate:create": "node-pg-migrate create --migrations-dir database/migrations",
    "db:seed": "node database/seeds/run.js"
  },
  "keywords": [
    "educacao",
    "ia",
    "gemini",
    "planos-de-aula",
    "bncc"
  ],
  "author": "Igor",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.0.2"
  }
}
